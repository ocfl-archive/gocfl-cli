{{ $root := . }}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .title }} - {{ .id }}</title>
    <link rel="stylesheet" href="../../../static/bootstrapdist/css/bootstrap.min.css">
    <link href="../../../static/css/sidebar.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .file-item {
            transition: background-color 0.15s ease;
        }
        .file-item:hover {
            background-color: #f1f3f5 !important;
        }
        .bd-aside {
            min-width: 260px;
        }
        .file-btn {
            text-align: left;
            word-break: break-all;
            font-weight: 500;
        }
        .filter-badge {
            cursor: pointer;
            user-select: none;
        }
    </style>
</head>

<body class="py-3">
    <main class="d-flex overflow-visible">
        <h1 class="visually-hidden">{{ .title }}</h1>

        <!-- Sidebar -->
        <aside class="bd-aside sticky-top text-muted align-self-start mb-3 mb-xl-5 px-3">
            <div class="flex-shrink-0 p-3 bg-white rounded-3 shadow-sm" style="width: 260px;">
                <a href="../../../" class="d-flex align-items-center pb-3 mb-3 link-dark text-decoration-none border-bottom">
                    <svg class="bi me-2 text-primary" width="28" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
                    </svg>
                    <span class="fs-5 fw-bold">gocfl</span>
                </a>
                <ul class="nav nav-pills flex-column mb-auto gap-1">
                    <li class="nav-item">
                        <a href="../../../object/id/{{ .id | PathEscape }}" class="nav-link text-dark d-flex align-items-center gap-2">
                            <svg class="bi text-secondary" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4zM3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10zm9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5zm.754-4.246a.389.389 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.389.389 0 0 0-.029-.518z"/><path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A7.988 7.988 0 0 1 0 10zm8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3z"/></svg>
                            Object
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="../../../object/id/{{ .id | PathEscape }}/manifest" class="nav-link active d-flex align-items-center gap-2">
                            <svg class="bi" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/></svg>
                            Manifest
                        </a>
                    </li>
                    {{ range $ver, $content := .versions }}
                    <li class="nav-item">
                        <a href="../../../object/id/{{ $root.id | PathEscape }}/version/{{ $ver }}" class="nav-link text-dark d-flex align-items-center gap-2 ps-4">
                            <span class="badge bg-light text-dark border">{{ $ver }}</span>
                            <span>Version {{ $ver }}</span>
                        </a>
                    </li>
                    {{ end }}
                    <hr class="my-2">
                    <li class="nav-item">
                        <a target="_blank" href="../../../object/id/{{ .id | PathEscape }}/report" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Short Report</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a target="_blank" href="../../../object/id/{{ .id | PathEscape }}/report?full" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Full Report</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a target="_blank" href="../../../object/id/{{ .id | PathEscape }}/browse/" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Browse Files</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <hr class="my-2">
                    <li class="nav-item">
                        <a href="../../../" class="nav-link text-secondary d-flex align-items-center gap-2">
                            <svg class="bi" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4H2.5z"/></svg>
                            Storage Root
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="container-fluid bg-transparent px-4">
            <!-- Header Banner -->
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary">Manifest</span>
                            <span class="text-muted small">All unique content files across all versions</span>
                        </div>
                        <h1 class="h3 mb-0 mt-1 font-monospace fw-bold text-dark text-break">{{ .id }}</h1>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span id="fileCounterBadge" class="badge bg-secondary fs-6 rounded-pill px-3 py-2">{{ len .files }} Files</span>
                    </div>
                </div>
            </div>

            <!-- Search and Filter Bar -->
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <svg class="bi text-muted" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                    </svg>
                                </span>
                                <input type="search" id="manifestSearch" class="form-control border-start-0 ps-0" placeholder="Filter by filename, PRONOM, MIME-type, checksum..." aria-label="Search files">
                            </div>
                        </div>
                        <div class="col-12 col-md-6 text-md-end text-muted small">
                            <span id="visibleCountText">Showing all {{ len .files }} files</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Files List -->
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <ul class="list-group list-group-flush" id="manifestFileList">
                    {{ range $name, $file := .files }}
                    <li class="list-group-item list-group-item-action d-flex flex-wrap justify-content-between align-items-center p-3 file-item"
                        data-name="{{ $name }}"
                        data-checksum="{{ $file.Checksum }}"
                        data-pronom="{{ $file.Pronom }}"
                        data-mime="{{ $file.Mimetype }}">
                        <div class="d-flex align-items-start gap-2 me-auto text-break col-12 col-lg-7">
                            <button type="button" class="btn btn-link p-0 text-decoration-none text-primary file-btn d-inline-flex align-items-center gap-2"
                                    data-bs-toggle="modal" data-bs-target="#detail"
                                    data-bs-id="{{ $root.id | PathEscape }}"
                                    data-bs-checksum="{{ $file.Checksum }}"
                                    data-bs-name="{{ $name }}">
                                <svg class="bi text-secondary flex-shrink-0" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5L14 4.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5h-2z"/>
                                </svg>
                                <span class="font-monospace">{{ $name }}</span>
                            </button>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-1 mt-2 mt-lg-0 justify-content-end">
                            {{ if $file.IdxSize }}
                                <span class="badge bg-light text-dark border">{{ $file.IdxSize }}</span>
                            {{ end }}
                            {{ if $file.Pronom }}
                                <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $file.Pronom }}" target="_blank" class="badge rounded-pill bg-info text-dark text-decoration-none">{{ $file.Pronom }}</a>
                            {{ end }}
                            {{ if $file.Mimetype }}
                                <span class="badge rounded-pill bg-light text-secondary border font-monospace small">{{ $file.Mimetype }}</span>
                            {{ end }}
                            {{ range $migName, $source := $file.Migration }}
                                <span class="badge rounded-pill bg-{{ if (eq $source $file.Checksum ) }}danger{{ else }}secondary{{ end }} text-dark">{{ $migName }}</span>
                            {{ end }}
                            <a href="../../../object/id/{{ $root.id | PathEscape }}/download/{{ $file.Checksum }}/{{ basename $name }}" download="{{ basename $name }}" class="btn btn-sm btn-outline-secondary py-0 px-2 ms-2" title="Download file">
                                <svg class="bi" width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                            </a>
                        </div>
                    </li>
                    {{ else }}
                    <li class="list-group-item p-4 text-center text-muted">
                        No files in manifest.
                    </li>
                    {{ end }}
                    <li id="noMatchManifest" class="list-group-item p-4 text-center text-muted d-none">
                        No files match your search criteria.
                    </li>
                </ul>
            </div>
        </div>

        <!-- Detail Modal -->
        <div class="modal fade" id="detail" tabindex="-1" aria-labelledby="detailLabel" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content">
                    <div class="modal-header py-2 px-3 bg-light border-bottom">
                        <div class="d-flex align-items-center gap-2 text-truncate">
                            <span class="badge bg-primary">File Details</span>
                            <h5 class="modal-title h6 mb-0 font-monospace text-truncate" id="detailLabel">Loading...</h5>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0">
                        <iframe style="border: none;"
                                src=""
                                width="100%"
                                height="100%"
                                sandbox="allow-same-origin allow-scripts allow-popups allow-forms allow-top-navigation"
                                allowtransparency="true">
                        </iframe>
                    </div>
                    <div class="modal-footer py-2 px-3 bg-light border-top">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="../../../static/bootstrapdist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Modal loader
        var detailModal = document.getElementById('detail');
        if (detailModal) {
            detailModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-bs-id');
                var checksum = button.getAttribute('data-bs-checksum');
                var name = button.getAttribute('data-bs-name') || id;
                var modalTitle = detailModal.querySelector('.modal-title');
                var modalIFrame = detailModal.querySelector('.modal-body iframe');
                modalIFrame.src = '../../../object/id/' + id + '/detail/' + checksum;
                modalTitle.textContent = name;
            });
            detailModal.addEventListener('hidden.bs.modal', function () {
                var modalIFrame = detailModal.querySelector('.modal-body iframe');
                if (modalIFrame) {
                    modalIFrame.src = '';
                }
            });
        }

        // Live Search Filter
        const searchInput = document.getElementById('manifestSearch');
        const fileItems = document.querySelectorAll('.file-item');
        const noMatch = document.getElementById('noMatchManifest');
        const countText = document.getElementById('visibleCountText');
        const totalCount = fileItems.length;

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const term = this.value.toLowerCase().trim();
                let visibleCount = 0;
                fileItems.forEach(item => {
                    const name = (item.getAttribute('data-name') || '').toLowerCase();
                    const checksum = (item.getAttribute('data-checksum') || '').toLowerCase();
                    const pronom = (item.getAttribute('data-pronom') || '').toLowerCase();
                    const mime = (item.getAttribute('data-mime') || '').toLowerCase();

                    if (!term || name.includes(term) || checksum.includes(term) || pronom.includes(term) || mime.includes(term)) {
                        item.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                if (visibleCount === 0 && totalCount > 0) {
                    noMatch.classList.remove('d-none');
                } else {
                    noMatch.classList.add('d-none');
                }

                if (term) {
                    countText.textContent = 'Showing ' + visibleCount + ' of ' + totalCount + ' files';
                } else {
                    countText.textContent = 'Showing all ' + totalCount + ' files';
                }
            });
        }
    </script>
</body>
</html>