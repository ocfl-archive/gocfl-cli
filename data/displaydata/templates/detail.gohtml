{{ $root := . }}<!DOCTYPE html>
{{ $status := $root.status }}
{{ $file := $root.file }}
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .title }} - {{ $status.Checksum }}</title>
    <link rel="stylesheet" href="../../../../static/bootstrapdist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-size: 0.95rem;
        }
        .nav-tabs .nav-link {
            font-weight: 500;
            color: #495057;
        }
        .nav-tabs .nav-link.active {
            font-weight: 600;
            color: #0d6efd;
            border-bottom: 2px solid #0d6efd;
        }
        .table-custom th {
            width: 220px;
            background-color: #f8f9fa;
            color: #495057;
        }
        .code-box {
            background-color: #212529;
            color: #f8f9fa;
            border-radius: 6px;
            padding: 1rem;
            font-family: monospace;
            font-size: 0.875rem;
            max-height: 400px;
            overflow-y: auto;
        }
        .thumb-preview-img {
            max-width: 100%;
            max-height: 350px;
            object-fit: contain;
            border-radius: 6px;
        }
    </style>
</head>

<body class="p-3">
    <div class="container-fluid">
        <!-- Top Summary Card -->
        <div class="card shadow-sm border-0 mb-3 bg-white">
            <div class="card-body p-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary fs-6">{{ $status.DigestAlgorithm }}</span>
                        <span class="font-monospace fw-bold text-dark text-break">{{ $status.Checksum }}</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        {{ if $status.Indexer }}
                            {{ if $status.Indexer.Pronom }}
                                <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $status.Indexer.Pronom }}" target="_blank" class="badge rounded-pill bg-info text-dark text-decoration-none">{{ $status.Indexer.Pronom }}</a>
                            {{ end }}
                            {{ if $status.Indexer.Mimetype }}
                                <span class="badge rounded-pill bg-light text-secondary border font-monospace">{{ $status.Indexer.Mimetype }}</span>
                            {{ end }}
                        {{ end }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-header bg-white border-bottom pt-3 pb-0 px-3">
                <ul class="nav nav-tabs border-bottom-0" id="detailTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-pane" type="button" role="tab" aria-controls="general-pane" aria-selected="true">
                            Overview & Checksums
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="filesystem-tab" data-bs-toggle="tab" data-bs-target="#filesystem-pane" type="button" role="tab" aria-controls="filesystem-pane" aria-selected="false">
                            Filesystem & Names
                        </button>
                    </li>
                    {{ if $status.Indexer }}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="indexer-tab" data-bs-toggle="tab" data-bs-target="#indexer-pane" type="button" role="tab" aria-controls="indexer-pane" aria-selected="false">
                            Indexer & Metadata
                        </button>
                    </li>
                    {{ end }}
                    {{ if or $status.Thumbnail $status.Migration }}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="migration-tab" data-bs-toggle="tab" data-bs-target="#migration-pane" type="button" role="tab" aria-controls="migration-pane" aria-selected="false">
                            {{ if and $status.Thumbnail $status.Migration }}Thumbnail & Migration{{ else if $status.Thumbnail }}Thumbnail{{ else }}Migration{{ end }}
                        </button>
                    </li>
                    {{ end }}
                </ul>
            </div>

            <div class="card-body p-4">
                <div class="tab-content" id="detailTabContent">
                    <!-- Tab 1: Overview & Checksums -->
                    <div class="tab-pane fade show active" id="general-pane" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
                        <h5 class="card-title fw-bold text-dark mb-3">Checksums & Fixity</h5>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-custom align-middle">
                                <tbody>
                                    <tr>
                                        <th class="text-end"><strong>Primary ({{ $status.DigestAlgorithm }})</strong></th>
                                        <td class="font-monospace text-break">{{ $status.Checksum }}</td>
                                    </tr>
                                    {{ if $status.Thumbnail }}
                                    <tr>
                                        <th class="text-end"><strong>ThumbDigest</strong></th>
                                        <td class="font-monospace text-break">{{ $status.Thumbnail.ThumbDigest }}</td>
                                    </tr>
                                    <tr>
                                        <th class="text-end"><strong>SourceDigest</strong></th>
                                        <td class="font-monospace text-break">{{ $status.Thumbnail.SourceDigest }}</td>
                                    </tr>
                                    {{ end }}
                                    {{ range $alg, $digest := $status.Fixity }}
                                    <tr>
                                        <th class="text-end"><strong>{{ $alg }}</strong></th>
                                        <td class="font-monospace text-break">{{ $digest }}</td>
                                    </tr>
                                    {{ end }}
                                </tbody>
                            </table>
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-3">Internal Names (OCFL Storage)</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Internal Path in Storage</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{ range $name := $status.InternalNames }}
                                    <tr>
                                        <td class="font-monospace">{{ $name }}</td>
                                    </tr>
                                    {{ else }}
                                    <tr>
                                        <td class="text-muted">No internal names recorded.</td>
                                    </tr>
                                    {{ end }}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 2: Filesystem & External Names -->
                    <div class="tab-pane fade" id="filesystem-pane" role="tabpanel" aria-labelledby="filesystem-tab" tabindex="0">
                        <h5 class="card-title fw-bold text-dark mb-3">External Names per Version</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 90px;">Version</th>
                                        <th>File Name & Path</th>
                                        <th>Timestamps</th>
                                        <th>Size</th>
                                        <th>Attributes</th>
                                        <th>OS</th>
                                        <th>System Stat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{ range $ver, $names := $status.ExternalNames }}
                                        {{ range $name := $names }}
                                        <tr>
                                            <td><span class="badge bg-primary">{{ $ver }}</span></td>
                                            <td>
                                                <a download="{{ basename $name.Name }}" href="../download/{{ $status.Checksum }}/{{ basename $name.Name }}" target="_blank" class="fw-semibold text-decoration-none font-monospace d-inline-flex align-items-center gap-1">
                                                    <svg class="bi" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/><path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/></svg>
                                                    {{ $name.Name }}
                                                </a>
                                            </td>
                                            <td class="small">
                                                {{ if $name.OS }}
                                                    <div><span class="text-muted">Created:</span> {{ $name.CTime }}</div>
                                                    <div><span class="text-muted">Modified:</span> {{ $name.MTime }}</div>
                                                    <div><span class="text-muted">Accessed:</span> {{ $name.ATime }}</div>
                                                {{ else }}
                                                    <span class="text-muted">-</span>
                                                {{ end }}
                                            </td>
                                            <td class="font-monospace small">{{ if $name.Size }}{{ $name.Size }}{{ else }}-{{ end }}</td>
                                            <td class="font-monospace small">{{ if $name.Attr }}{{ $name.Attr }}{{ else }}-{{ end }}</td>
                                            <td class="small">{{ if $name.OS }}{{ $name.OS }}{{ else }}-{{ end }}</td>
                                            <td>
                                                {{ if $name.Sys }}
                                                    <json-viewer>{{ $name.Sys }}</json-viewer>
                                                {{ else }}
                                                    <span class="text-muted">-</span>
                                                {{ end }}
                                            </td>
                                        </tr>
                                        {{ end }}
                                    {{ else }}
                                    <tr>
                                        <td colspan="7" class="text-muted text-center p-3">No external names recorded.</td>
                                    </tr>
                                    {{ end }}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tab 3: Indexer & Metadata -->
                    {{ if $status.Indexer }}
                    <div class="tab-pane fade" id="indexer-pane" role="tabpanel" aria-labelledby="indexer-tab" tabindex="0">
                        {{ if $status.Indexer.Errors }}
                            <div class="alert alert-warning mb-3" role="alert">
                                <h6 class="alert-heading fw-bold">Indexer Warnings / Errors</h6>
                                <ul class="mb-0">
                                    {{ range $errT, $err := $status.Indexer.Errors }}
                                    <li><strong>{{ $errT }}:</strong> {{ $err }}</li>
                                    {{ end }}
                                </ul>
                            </div>
                        {{ end }}

                        <h5 class="card-title fw-bold text-dark mb-3">Format Identification</h5>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered table-custom align-middle">
                                <tbody>
                                    <tr>
                                        <th class="text-end"><strong>Type / Subtype</strong></th>
                                        <td>
                                            <span class="badge bg-secondary">{{ $status.Indexer.Type }}</span>
                                            {{ if $status.Indexer.Subtype }}<span class="badge bg-light text-dark border">{{ $status.Indexer.Subtype }}</span>{{ end }}
                                        </td>
                                    </tr>
                                    {{ if $status.Indexer.Mimetypes }}
                                    <tr>
                                        <th class="text-end"><strong>MIMETypes</strong></th>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                {{ range $mime := $status.Indexer.Mimetypes }}
                                                <span class="badge bg-light text-dark border font-monospace">{{ $mime }}</span>
                                                {{ end }}
                                            </div>
                                        </td>
                                    </tr>
                                    {{ end }}
                                    {{ if $status.Indexer.Pronoms }}
                                    <tr>
                                        <th class="text-end"><strong>PRONOM PUIDs</strong></th>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                {{ range $pronom := $status.Indexer.Pronoms }}
                                                <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $pronom }}" target="_blank" class="badge rounded-pill bg-info text-dark text-decoration-none">{{ $pronom }}</a>
                                                {{ end }}
                                            </div>
                                        </td>
                                    </tr>
                                    {{ end }}
                                    {{ if $status.Indexer.Width }}
                                    <tr>
                                        <th class="text-end"><strong>Dimensions</strong></th>
                                        <td class="font-monospace">{{ $status.Indexer.Width | toString }} &times; {{ $status.Indexer.Height | toString }} px</td>
                                    </tr>
                                    {{ end }}
                                    {{ if $status.Indexer.Duration }}
                                    <tr>
                                        <th class="text-end"><strong>Duration</strong></th>
                                        <td class="font-monospace">{{ $status.Indexer.Duration | toString }} sec</td>
                                    </tr>
                                    {{ end }}
                                </tbody>
                            </table>
                        </div>

                        {{ if $status.IndexerJSON }}
                        <h5 class="card-title fw-bold text-dark mb-3">Full Metadata JSON</h5>
                        <div class="border rounded p-3 bg-light">
                            <json-viewer>{{ $status.IndexerJSON }}</json-viewer>
                        </div>
                        {{ end }}
                    </div>
                    {{ end }}

                    <!-- Tab 4: Thumbnail & Migration -->
                    {{ if or $status.Thumbnail $status.Migration }}
                    <div class="tab-pane fade" id="migration-pane" role="tabpanel" aria-labelledby="migration-tab" tabindex="0">
                        {{ if $status.Thumbnail }}
                        <div class="mb-4">
                            <h5 class="card-title fw-bold text-dark mb-3">Thumbnail Preview</h5>
                            <div class="card border p-3 bg-light">
                                {{ if eq $status.Thumbnail.ThumbDigest $status.Checksum }}
                                    <div class="mb-2">
                                        <span class="badge bg-info text-dark">This file is a Thumbnail</span>
                                    </div>
                                    <div>
                                        <strong>Thumbnail Source:</strong>
                                        {{ range $key, $sn := $status.Thumbnail.SourceName }}
                                            {{ if gt $key 0 }}, {{ end }}
                                            <a href="{{ $status.Thumbnail.SourceDigest }}" class="font-monospace text-decoration-none">{{ $sn }}</a>
                                        {{ end }}
                                    </div>
                                {{ else }}
                                    <div class="mb-3">
                                        <strong>Process:</strong> <span class="badge bg-secondary">{{ $status.Thumbnail.ID }}</span>
                                        {{ if $status.Thumbnail.Filename }}
                                            <span class="text-muted ms-2 font-monospace">({{ $status.Thumbnail.Filename }})</span>
                                        {{ end }}
                                    </div>
                                    {{ if $status.Thumbnail.Error }}
                                        <div class="alert alert-danger py-2 mb-3">{{ $status.Thumbnail.Error }}</div>
                                    {{ end }}
                                    {{- $imgUrl := "" }}
                                    {{- if eq $status.Thumbnail.StorageType "extension" }}
                                        {{- $imgUrl = printf "../extension/NNNN-thumbnail/download/%s" $status.Thumbnail.Filename }}
                                    {{- else }}
                                        {{- $imgUrl = printf "../download/%s/%s" $status.Thumbnail.ThumbDigest (basename $status.Thumbnail.Filename) }}
                                    {{- end }}
                                    <div class="text-center p-3 bg-white border rounded">
                                        <img src="{{ $imgUrl }}" alt="Thumbnail Image" class="thumb-preview-img shadow-sm border" />
                                    </div>
                                {{ end }}
                            </div>
                        </div>
                        {{ end }}

                        {{ if $status.Migration }}
                        <div>
                            <h5 class="card-title fw-bold text-dark mb-3">Migration Details</h5>
                            <div class="card border p-3 bg-light">
                                <div class="mb-2">
                                    <strong>Migration Process ID:</strong> <span class="badge bg-secondary">{{ $status.Migration.ID }}</span>
                                </div>
                                {{ if $status.Migration.Error }}
                                    <div class="alert alert-danger py-2 mb-3">{{ $status.Migration.Error }}</div>
                                {{ end }}
                                <div>
                                    <strong>Source File:</strong>
                                    <a href="{{ $status.Migration.Source }}" class="font-monospace text-decoration-none">{{ $status.Migration.Source }}</a>
                                </div>
                            </div>
                        </div>
                        {{ end }}
                    </div>
                    {{ end }}
                </div>
            </div>
        </div>
    </div>

    <script src="../../../../static/bootstrapdist/js/bootstrap.bundle.min.js"></script>
    <script src="../../../../static/js/json-viewer.bundle.js"></script>
</body>
</html>