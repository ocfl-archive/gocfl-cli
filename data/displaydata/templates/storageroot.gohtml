<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .title }} - Storage Root</title>
    <link rel="stylesheet" href="/static/bootstrapdist/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .search-box {
            position: relative;
        }
        .folder-card {
            transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .folder-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }
        .folder-item {
            transition: background-color 0.15s ease;
        }
        .folder-item:hover {
            background-color: #e9ecef !important;
        }
    </style>
</head>
<body class="py-4">
    <div class="container py-3">
        <!-- Header -->
        <header class="d-flex flex-wrap align-items-center justify-content-between pb-3 mb-4 border-bottom">
            <a href="/" class="d-flex align-items-center text-dark text-decoration-none">
                <svg class="bi me-2 text-primary" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
                </svg>
                <span class="fs-4 fw-bold">gocfl</span>
                <span class="badge bg-secondary ms-2">Storage Root</span>
            </a>
            <div class="text-end text-muted small">
                <span>Location: </span><code class="text-dark bg-white px-2 py-1 rounded border">{{ .storageroot }}</code>
            </div>
        </header>

        <!-- Main Card -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0 fw-semibold">OCFL Objects</h5>
                    <span id="counterBadge" class="badge bg-primary rounded-pill">{{ len .folders }}</span>
                </div>
                <!-- Search Box -->
                <div class="search-box col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <svg class="bi" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                            </svg>
                        </span>
                        <input type="search" id="folderSearch" class="form-control border-start-0 ps-0" placeholder="Filter objects by path / ID..." aria-label="Filter objects">
                    </div>
                </div>
            </div>

            <!-- Folders List -->
            <div class="list-group list-group-flush" id="folderList">
                {{ range $folder := .folders }}
                <a href="/object/folder/{{ $folder }}" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between py-3 px-4 folder-item" data-folder="{{ $folder }}">
                    <div class="d-flex align-items-center">
                        <svg class="bi me-3 text-secondary" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M.54 3.87.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31zM2.19 4a1 1 0 0 0-.996 1.09l.637 7a1 1 0 0 0 .995.91h10.348a1 1 0 0 0 .995-.91l.637-7A1 1 0 0 0 13.81 4H2.19zm4.69-1.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139C1.72 3.042 1.95 3 2.19 3h5.396l-.707-.707z"/>
                        </svg>
                        <span class="fw-medium text-dark font-monospace">{{ $folder }}</span>
                    </div>
                    <span class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                        Inspect
                        <svg class="bi" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
                        </svg>
                    </span>
                </a>
                {{ else }}
                <div class="p-4 text-center text-muted">
                    No OCFL objects found in this storage root.
                </div>
                {{ end }}
                <div id="noMatchAlert" class="p-4 text-center text-muted d-none">
                    No objects match your search query.
                </div>
            </div>
        </div>
    </div>

    <script src="/static/bootstrapdist/js/bootstrap.bundle.min.js"></script>
    <script>
        const searchInput = document.getElementById('folderSearch');
        const folderItems = document.querySelectorAll('.folder-item');
        const noMatchAlert = document.getElementById('noMatchAlert');
        const counterBadge = document.getElementById('counterBadge');
        const totalCount = folderItems.length;

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const term = this.value.toLowerCase().trim();
                let visibleCount = 0;
                folderItems.forEach(item => {
                    const folder = item.getAttribute('data-folder').toLowerCase();
                    if (folder.includes(term)) {
                        item.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        item.classList.add('d-none');
                    }
                });

                if (visibleCount === 0 && totalCount > 0) {
                    noMatchAlert.classList.remove('d-none');
                } else {
                    noMatchAlert.classList.add('d-none');
                }

                if (term) {
                    counterBadge.textContent = visibleCount + ' / ' + totalCount;
                } else {
                    counterBadge.textContent = totalCount;
                }
            });
        }
    </script>
</body>
</html>