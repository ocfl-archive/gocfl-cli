{{$data := . }}<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <title>OCFL Archive Report - {{ .id }}</title>
    {{- if $data.polyfilled }}
    <script src="../../../../static/js/paged.polyfill.js"></script>
    {{- end }}
    <link href="../../../../static/css/interface.css" rel="stylesheet" type="text/css" />
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-light: #eff6ff;
            --text-main: #1f2937;
            --text-muted: #4b5563;
            --border-color: #e5e7eb;
            --border-dark: #d1d5db;
            --bg-subtle: #f9fafb;
            --bg-card: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-main);
            line-height: 1.45;
            font-size: 9.5pt;
            margin: 0;
            padding: 0;
            background: #ffffff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        @page:first {
            margin-top: 15mm;
            margin-right: 18mm;
            margin-bottom: 20mm;
            margin-left: 18mm;

            @bottom-left {
                content: "";
            }
            @bottom-right {
                font-size: 7.5pt;
                color: #6b7280;
                content: "Erstellt mit {{ .gocfl }}";
            }
            @top-center {
                content: "";
            }
        }

        @page {
            size: A4;
            margin-top: 18mm;
            margin-right: 18mm;
            margin-bottom: 20mm;
            margin-left: 18mm;

            @top-left {
                font-size: 7.5pt;
                font-weight: 600;
                color: #6b7280;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                content: "OCFL Archive Report";
                border-bottom: 0.5pt solid #e5e7eb;
                padding-bottom: 4px;
            }

            @top-right {
                font-size: 7.5pt;
                color: #6b7280;
                content: "{{ .id }}";
                border-bottom: 0.5pt solid #e5e7eb;
                padding-bottom: 4px;
            }

            @bottom-left {
                font-size: 7.5pt;
                color: #6b7280;
                content: "Seite " counter(page) " von " counter(pages);
                border-top: 0.5pt solid #e5e7eb;
                padding-top: 4px;
            }

            @bottom-right {
                font-size: 7.5pt;
                color: #6b7280;
                content: "{{ .gocfl }}";
                border-top: 0.5pt solid #e5e7eb;
                padding-top: 4px;
            }
        }

        h1, h2, h3, h4 {
            color: #111827;
            font-weight: 700;
            margin-top: 0;
            break-after: avoid;
        }

        h1 {
            font-size: 16pt;
            margin-bottom: 8pt;
        }

        h2 {
            font-size: 13pt;
            margin-bottom: 6pt;
            border-bottom: 1.5pt solid var(--primary);
            padding-bottom: 3pt;
            display: inline-block;
            width: 100%;
        }

        h3 {
            font-size: 11pt;
            margin-bottom: 4pt;
        }

        .chapter {
            break-before: page;
        }

        .chapter-first {
            break-before: auto;
        }

        /* Cover Page Styling */
        .cover-header {
            border-bottom: 2pt solid var(--primary);
            padding-bottom: 12pt;
            margin-bottom: 20pt;
            margin-top: 20pt;
        }

        .cover-badge {
            display: inline-block;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 8pt;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 3pt 8pt;
            border-radius: 3pt;
            margin-bottom: 8pt;
        }

        .cover-title {
            font-size: 18pt;
            line-height: 1.25;
            color: #0f172a;
            word-break: break-all;
            margin-bottom: 6pt;
        }

        .cover-subtitle {
            font-size: 10.5pt;
            color: var(--text-muted);
            font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        }

        .callout-box {
            background: var(--bg-subtle);
            border-left: 3pt solid var(--primary);
            border-radius: 0 4pt 4pt 0;
            padding: 10pt 12pt;
            margin-bottom: 14pt;
            font-size: 9pt;
            color: #374151;
            break-inside: avoid;
        }

        .callout-box p {
            margin: 0;
        }
        .callout-box p + p {
            margin-top: 6pt;
        }

        /* Versions card table */
        .card-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 12pt;
            margin-bottom: 14pt;
            border: 1pt solid var(--border-color);
            border-radius: 4pt;
            overflow: hidden;
            break-inside: avoid;
            font-size: 9pt;
        }

        .card-table th {
            background: #f3f4f6;
            color: #1f2937;
            font-weight: 600;
            text-align: left;
            padding: 6pt 10pt;
            border-bottom: 1pt solid var(--border-color);
        }

        .card-table td {
            padding: 5pt 10pt;
            border-bottom: 0.5pt solid var(--border-color);
            vertical-align: top;
        }

        .card-table tr:last-child td {
            border-bottom: none;
        }

        .card-table td.label-col {
            width: 25%;
            font-weight: 600;
            color: var(--text-muted);
            background: #fafafa;
        }

        /* Metrics / KPI Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8pt;
            margin-bottom: 16pt;
            break-inside: avoid;
        }

        .metric-card {
            background: var(--bg-subtle);
            border: 1pt solid var(--border-color);
            border-radius: 4pt;
            padding: 8pt 12pt;
        }

        .metric-value {
            font-size: 15pt;
            font-weight: 700;
            color: var(--primary);
            line-height: 1.2;
        }

        .metric-label {
            font-size: 8pt;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            margin-top: 2pt;
        }

        /* Data Tables */
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 16pt;
            font-size: 8.5pt;
            break-inside: auto;
        }

        table.data-table tr {
            break-inside: avoid;
        }

        table.data-table th {
            background: #f3f4f6;
            color: #374151;
            font-weight: 600;
            text-align: left;
            padding: 5pt 8pt;
            border-top: 1pt solid var(--border-dark);
            border-bottom: 1.5pt solid var(--border-dark);
            letter-spacing: 0.3px;
        }

        table.data-table th.num,
        table.data-table td.num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        table.data-table td {
            padding: 4.5pt 8pt;
            border-bottom: 0.5pt solid var(--border-color);
            color: #1f2937;
        }

        table.data-table tr:nth-child(even) td {
            background: #fbfbfb;
        }

        table.data-table td.code-cell {
            font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
            font-size: 8pt;
            word-break: break-all;
        }

        /* Info Metadata Table */
        .meta-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8.5pt;
            margin-top: 8pt;
            margin-bottom: 14pt;
            break-inside: avoid;
        }

        .meta-table tr {
            border-bottom: 0.5pt solid var(--border-color);
        }

        .meta-table td {
            padding: 4.5pt 8pt;
            vertical-align: top;
        }

        .meta-table td.meta-key {
            width: 25%;
            font-weight: 600;
            color: var(--text-muted);
            background: #fafafa;
        }

        /* Directory Tree */
        table.tree {
            width: 100%;
            border-collapse: collapse;
            font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
            font-size: 8pt;
            break-inside: auto;
        }

        table.tree tr {
            break-inside: avoid;
        }

        table.tree td {
            padding: 2pt 4pt;
            line-height: 1.35;
        }

        table.tree td.tree-indent {
            width: 18px;
            border-right: 1pt dotted #d1d5db;
        }

        table.tree td.tree-node {
            color: #1f2937;
            word-break: break-all;
        }

        /* File Card Layout */
        .file-card {
            border: 1pt solid var(--border-color);
            border-radius: 4pt;
            margin-bottom: 10pt;
            padding: 8pt;
            background: #ffffff;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        table.file-layout {
            width: 100%;
            border-collapse: collapse;
        }

        td.file-thumb-cell {
            width: 130px;
            vertical-align: top;
            padding-right: 10pt;
            text-align: center;
        }

        .file-thumb-img {
            max-width: 120px;
            max-height: 120px;
            object-fit: contain;
            border: 1pt solid #e5e7eb;
            border-radius: 3pt;
            background: #fdfdfd;
        }

        .file-thumb-placeholder {
            width: 120px;
            height: 80px;
            border: 1pt dashed #d1d5db;
            border-radius: 3pt;
            background: #f9fafb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 7.5pt;
            color: #9ca3af;
        }

        td.file-details-cell {
            vertical-align: top;
        }

        table.file-meta {
            width: 100%;
            border-collapse: collapse;
            font-size: 8pt;
        }

        table.file-meta td {
            padding: 2.5pt 6pt;
            vertical-align: top;
            border-bottom: 0.5pt solid #f3f4f6;
        }

        table.file-meta tr:last-child td {
            border-bottom: none;
        }

        table.file-meta td.label {
            width: 110px;
            font-weight: 600;
            color: var(--text-muted);
            white-space: nowrap;
        }

        table.file-meta td.val {
            color: #111827;
            word-break: break-all;
        }

        .badge {
            display: inline-block;
            padding: 1.5pt 5pt;
            border-radius: 2pt;
            font-size: 7.5pt;
            font-weight: 600;
            background: #e5e7eb;
            color: #374151;
        }

        .badge-pronom {
            background: #e0e7ff;
            color: #3730a3;
            font-family: ui-monospace, "Cascadia Code", Consolas, monospace;
        }
    </style>
</head>
<body>

<!-- COVER PAGE -->
<div class="chapter chapter-first">
    <div class="cover-header">
        <span class="cover-badge">OCFL Archive Report</span>
        <div class="cover-title">{{ .id }}</div>
        <div class="cover-subtitle">{{ .objectpath }}</div>
    </div>

    <div class="callout-box">
        <p><strong>Archivbericht:</strong> Der vorliegende Report basiert auf der OCFL-Dokumentation des Datenpakets <code>{{ .objectpath }}</code>. Er enthält die Metadaten, die im Zuge der Archivierung für die enthaltenen Dateien erfasst und validiert wurden.</p>
        <p><strong>Archive Report:</strong> This report is based on the OCFL documentation of the data package <code>{{ .objectpath }}</code>. It contains the metadata generated and validated during archiving for each archived file.</p>
    </div>

    {{- range $ver, $version := .versions }}
    <table class="card-table">
        <tr>
            <th colspan="2">OCFL Object Version: {{ $ver }}</th>
        </tr>
        <tr>
            <td class="label-col">Created</td>
            <td>{{ humanizeTime $version.Created }}</td>
        </tr>
        <tr>
            <td class="label-col">Name</td>
            <td>{{ $version.Name }}</td>
        </tr>
        <tr>
            <td class="label-col">Address</td>
            <td>{{ $version.Address }}</td>
        </tr>
        <tr>
            <td class="label-col">Message</td>
            <td>{{ $version.Message }}</td>
        </tr>
    </table>
    {{- end }}
</div>

<!-- INFO METADATA -->
{{- if .info }}
<div class="chapter">
    <h2>Objekt-Metadaten / Object Information</h2>
    
    <div style="margin-bottom: 12pt;">
        <h3 style="color: var(--primary); margin-bottom: 2pt;">{{ .info.title }}</h3>
        {{- if or .info.organisation .info.collection }}
        <div style="font-size: 9.5pt; font-weight: 600; color: #4b5563;">
            {{ .info.organisation }}{{ if and .info.organisation .info.collection }} &bull; {{ end }}{{ .info.collection }}
        </div>
        {{- end }}
        {{- if or .info.user .info.created }}
        <div style="font-size: 8.5pt; color: #6b7280; margin-top: 2pt;">
            {{ .info.user }}{{ if and .info.user .info.created }} &bull; {{ end }}{{ .info.created }}
        </div>
        {{- end }}
    </div>

    {{- if .info.description }}
    <div class="callout-box">
        {{ .info.description }}
    </div>
    {{- end }}

    <table class="meta-table">
        {{- if .info.alternative_titles }}
        <tr>
            <td class="meta-key">Alternative Titles</td>
            <td>
                {{- range $key, $altTitle := .info.alternative_titles }}
                    {{ if $key }}<br />{{ end }}{{ $altTitle }}
                {{- end }}
            </td>
        </tr>
        {{- end }}
        {{- if .info.signature }}
        <tr>
            <td class="meta-key">Signature</td>
            <td><strong>{{ .info.signature }}</strong></td>
        </tr>
        {{- end }}
        {{- if .info.organisation_id }}
        <tr>
            <td class="meta-key">Organisation ID</td>
            <td>{{ .info.organisation_id }}</td>
        </tr>
        {{- end }}
        {{- if .info.collection_id }}
        <tr>
            <td class="meta-key">Collection ID</td>
            <td>{{ .info.collection_id }}</td>
        </tr>
        {{- end }}
        {{- if .info.sets }}
        <tr>
            <td class="meta-key">Sets</td>
            <td>{{ .info.sets | join ", " }}</td>
        </tr>
        {{- end }}
        {{- if .info.keywords }}
        <tr>
            <td class="meta-key">Keywords</td>
            <td>{{ .info.keywords | join ", " }}</td>
        </tr>
        {{- end }}
        {{- if .info.identifiers }}
        <tr>
            <td class="meta-key">Identifiers</td>
            <td>
                {{- range $key, $identifier := .info.identifiers }}
                    {{ if $key }}<br />{{ end }}<code>{{ $identifier }}</code>
                {{- end }}
            </td>
        </tr>
        {{- end }}
        {{- if .info.references }}
        <tr>
            <td class="meta-key">References</td>
            <td>
                {{- range $key, $reference := .info.references }}
                    {{ if $key }}<br />{{ end }}{{ $reference }}
                {{- end }}
            </td>
        </tr>
        {{- end }}
        {{- if .info.deprecates }}
        <tr>
            <td class="meta-key">Deprecates</td>
            <td>{{ .info.deprecates }}</td>
        </tr>
        {{- end }}
        {{- if .info.ingest_workflow }}
        <tr>
            <td class="meta-key">Ingest Workflow</td>
            <td>{{ .info.ingest_workflow }}</td>
        </tr>
        {{- end }}
    </table>
</div>
{{- end }}

<!-- CONTENT OVERVIEW -->
<div class="chapter">
    <h2>Inhaltsübersicht / Content Overview</h2>

    {{- if gt (len .areaStats) 1 }}
    <h3 style="margin-top: 10pt; margin-bottom: 6pt;">Gesamt / Total</h3>
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-value">{{ .numFiles }}</div>
            <div class="metric-label">Dateien gesamt / Total Files</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ humanizeBytes .size }}</div>
            <div class="metric-label">Gesamtgröße / Total Size</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ .avLength }}</div>
            <div class="metric-label">A/V Mediendauer / Media Duration</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ .differentFiles }}</div>
            <div class="metric-label">Eindeutige Dateien / Distinct Files</div>
        </div>
    </div>

    {{- if .mimeTypes }}
    <h4 style="margin-top: 10pt; margin-bottom: 4pt; font-size: 9pt; color: #374151;">MIME-Types (Gesamt / Total)</h4>
    <table class="data-table">
        <thead>
            <tr>
                <th>MIME-Type</th>
                <th class="num" style="width: 80px;">Anzahl</th>
                <th class="num" style="width: 100px;">Größe</th>
            </tr>
        </thead>
        <tbody>
        {{- range $mime, $pSize := .mimeTypes }}
            <tr>
                <td class="code-cell">{{ $mime }}</td>
                <td class="num">{{ $pSize.Count }}</td>
                <td class="num">{{ $pSize.SizeStr }}</td>
            </tr>
        {{- end }}
        </tbody>
    </table>
    {{- end }}

    {{- if .pronoms }}
    <h4 style="margin-top: 10pt; margin-bottom: 4pt; font-size: 9pt; color: #374151;">PRONOM Formate (Gesamt / Total)</h4>
    <table class="data-table">
        <thead>
            <tr>
                <th>PRONOM Identifier</th>
                <th class="num" style="width: 80px;">Anzahl</th>
                <th class="num" style="width: 100px;">Größe</th>
            </tr>
        </thead>
        <tbody>
        {{- range $pronom, $pSize := .pronoms }}
            <tr>
                <td><span class="badge badge-pronom">{{ $pronom }}</span></td>
                <td class="num">{{ $pSize.Count }}</td>
                <td class="num">{{ $pSize.SizeStr }}</td>
            </tr>
        {{- end }}
        </tbody>
    </table>
    {{- end }}
    {{- end }}

    {{- range $area := .areaStats }}
    <div style="{{ if gt (len $data.areaStats) 1 }}margin-top: 14pt; padding-top: 8pt; border-top: 1pt solid var(--border-color);{{ end }}">
        {{- if or (gt (len $data.areaStats) 1) $area.Name }}
        <h3 style="margin-top: 8pt; margin-bottom: 6pt;">
            Area: {{ if $area.Name }}{{ $area.Name }}{{ else }}Default Area{{ end }}
            {{- if $area.Description }} <span style="font-size: 8.5pt; font-weight: normal; color: var(--text-muted);">({{ $area.Description }}{{ if $area.Path }}, <code>{{ $area.Path }}</code>{{ end }})</span>{{ else if $area.Path }} <span style="font-size: 8.5pt; font-weight: normal; color: var(--text-muted);">(<code>{{ $area.Path }}</code>)</span>{{ end }}
        </h3>
        {{- end }}

        <div class="metrics-grid">
            <div class="metric-card">
                <div class="metric-value">{{ $area.NumFiles }}</div>
                <div class="metric-label">Dateien gesamt / Total Files</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ $area.SizeStr }}</div>
                <div class="metric-label">Gesamtgröße / Total Size</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ $area.AVLength }}</div>
                <div class="metric-label">A/V Mediendauer / Media Duration</div>
            </div>
            <div class="metric-card">
                <div class="metric-value">{{ $area.DifferentFiles }}</div>
                <div class="metric-label">Eindeutige Dateien / Distinct Files</div>
            </div>
        </div>

        {{- if $area.MimeTypes }}
        <h4 style="margin-top: 10pt; margin-bottom: 4pt; font-size: 9pt; color: #374151;">MIME-Types{{ if $area.Name }} ({{ $area.Name }}){{ end }}</h4>
        <table class="data-table">
            <thead>
                <tr>
                    <th>MIME-Type</th>
                    <th class="num" style="width: 80px;">Anzahl</th>
                    <th class="num" style="width: 100px;">Größe</th>
                </tr>
            </thead>
            <tbody>
            {{- range $mime, $pSize := $area.MimeTypes }}
                <tr>
                    <td class="code-cell">{{ $mime }}</td>
                    <td class="num">{{ $pSize.Count }}</td>
                    <td class="num">{{ $pSize.SizeStr }}</td>
                </tr>
            {{- end }}
            </tbody>
        </table>
        {{- end }}

        {{- if $area.Pronoms }}
        <h4 style="margin-top: 10pt; margin-bottom: 4pt; font-size: 9pt; color: #374151;">PRONOM Formate{{ if $area.Name }} ({{ $area.Name }}){{ end }}</h4>
        <table class="data-table">
            <thead>
                <tr>
                    <th>PRONOM Identifier</th>
                    <th class="num" style="width: 80px;">Anzahl</th>
                    <th class="num" style="width: 100px;">Größe</th>
                </tr>
            </thead>
            <tbody>
            {{- range $pronom, $pSize := $area.Pronoms }}
                <tr>
                    <td><span class="badge badge-pronom">{{ $pronom }}</span></td>
                    <td class="num">{{ $pSize.Count }}</td>
                    <td class="num">{{ $pSize.SizeStr }}</td>
                </tr>
            {{- end }}
            </tbody>
        </table>
        {{- end }}
    </div>
    {{- end }}

    {{- if not .areaStats }}
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-value">{{ .numFiles }}</div>
            <div class="metric-label">Dateien gesamt / Total Files</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ humanizeBytes .size }}</div>
            <div class="metric-label">Gesamtgröße / Total Size</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ .avLength }}</div>
            <div class="metric-label">A/V Mediendauer / Media Duration</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ .differentFiles }}</div>
            <div class="metric-label">Eindeutige Dateien / Distinct Files</div>
        </div>
    </div>
    {{- if .mimeTypes }}
    <h3 style="margin-top: 10pt; margin-bottom: 4pt;">MIME-Types</h3>
    <table class="data-table">
        <thead>
            <tr>
                <th>MIME-Type</th>
                <th class="num" style="width: 80px;">Anzahl</th>
                <th class="num" style="width: 100px;">Größe</th>
            </tr>
        </thead>
        <tbody>
        {{- range $mime, $pSize := .mimeTypes }}
            <tr>
                <td class="code-cell">{{ $mime }}</td>
                <td class="num">{{ $pSize.Count }}</td>
                <td class="num">{{ $pSize.SizeStr }}</td>
            </tr>
        {{- end }}
        </tbody>
    </table>
    {{- end }}

    {{- if .pronoms }}
    <h3 style="margin-top: 10pt; margin-bottom: 4pt;">PRONOM Formate</h3>
    <table class="data-table">
        <thead>
            <tr>
                <th>PRONOM Identifier</th>
                <th class="num" style="width: 80px;">Anzahl</th>
                <th class="num" style="width: 100px;">Größe</th>
            </tr>
        </thead>
        <tbody>
        {{- range $pronom, $pSize := .pronoms }}
            <tr>
                <td><span class="badge badge-pronom">{{ $pronom }}</span></td>
                <td class="num">{{ $pSize.Count }}</td>
                <td class="num">{{ $pSize.SizeStr }}</td>
            </tr>
        {{- end }}
        </tbody>
    </table>
    {{- end }}
    {{- end }}
</div>

<!-- DIRECTORY LISTING -->
<div class="chapter">
    <h2>Verzeichnisstruktur / Directory Structure</h2>
    <div style="font-size: 8.5pt; color: var(--text-muted); margin-top: -4pt; margin-bottom: 8pt;">
        {{- if .reportAreas }}
        Gelistete Bereiche / Listed Areas: {{ range $i, $a := .reportAreas }}{{ if $i }}, {{ end }}<strong>{{ if $a }}{{ $a }}{{ else }}Default Area{{ end }}</strong>{{ end }}
        {{- else }}
        Gelistete Bereiche / Listed Areas: Alle / All
        {{- end }}
    </div>
    <div style="background: var(--bg-subtle); border: 1pt solid var(--border-color); border-radius: 4pt; padding: 8pt; margin-top: 8pt;">
        <table class="tree">
            {{- range $node := .tree }}
                <tr>
                    {{- range $i := (until $node.Left) }}
                    <td class="tree-indent"{{ if not $i }} style="border-right: none"{{ end }}></td>
                    {{- end }}
                    <td class="tree-node" colspan={{ add1 $node.Right }}>{{ $node.Name }}</td>
                </tr>
            {{- end }}
        </table>
    </div>
</div>

<!-- FILE DETAILS -->
{{- if len .files }}
<div class="chapter">
    <h2>Dateidetails / File Details</h2>
    <div style="font-size: 8.5pt; color: var(--text-muted); margin-top: -4pt; margin-bottom: 8pt;">
        {{- if .reportAreas }}
        Gelistete Bereiche / Listed Areas: {{ range $i, $a := .reportAreas }}{{ if $i }}, {{ end }}<strong>{{ if $a }}{{ $a }}{{ else }}Default Area{{ end }}</strong>{{ end }}
        {{- else }}
        Gelistete Bereiche / Listed Areas: Alle / All
        {{- end }}
    </div>

    {{range $cs, $file := .files}}
        {{- $thumb := (index $file.Extension "NNNN-thumbnail") }}
        {{- $indexer := (index $file.Extension "NNNN-indexer") }}
        {{- $filesystem := (index $file.Extension "NNNN-filesystem") }}
        {{- $extNames := (index $file.VersionName $data.head.String) }}
        {{- $hasThumb := and (and $thumb (not $thumb.Error)) (eq $thumb.SourceDigest $cs) }}
        {{- $isThumb := and (and $thumb (not $thumb.Error)) (eq $thumb.ThumbDigest $cs) }}
        {{- if eq (len $extNames) 0 }}
            {{- continue }}
        {{- end }}

        <div class="file-card">
            <table class="file-layout">
                <tr>
                    {{- if $hasThumb }}
                        {{- $imgUrl := "" }}
                        {{- if eq $thumb.StorageType "extension" }}
                            {{- $imgUrl = printf "extension/NNNN-thumbnail/download/%s" $thumb.Filename }}
                        {{- else }}
                            {{- $imgUrl = printf "download/%s/%s" $thumb.ThumbDigest (basename $thumb.Filename) }}
                        {{- end }}
                        <td class="file-thumb-cell">
                            <img class="file-thumb-img" src="{{ $imgUrl }}" alt="Thumbnail" />
                        </td>
                    {{- end }}
                    <td class="file-details-cell">
                        <table class="file-meta">
                            {{- range $key, $extName := $extNames }}
                            <tr>
                                <td class="label">Dateipfad</td>
                                <td class="val"><strong>{{ $extName }}</strong></td>
                            </tr>
                            {{- end }}
                            {{- if $indexer }}
                                {{- if ne $indexer.Type "" }}
                                <tr>
                                    <td class="label">Medientyp</td>
                                    <td class="val"><span class="badge">{{ $indexer.Type }} / {{ $indexer.Subtype }}</span></td>
                                </tr>
                                {{- end }}
                                <tr>
                                    <td class="label">PRONOM UID</td>
                                    <td class="val"><span class="badge badge-pronom">{{ $indexer.Pronom }}</span></td>
                                </tr>
                                <tr>
                                    <td class="label">Content-Type</td>
                                    <td class="val"><code>{{ $indexer.Mimetype }}</code></td>
                                </tr>
                                {{- if $indexer.Width }}
                                <tr>
                                    <td class="label">Dimension</td>
                                    <td class="val">{{ $indexer.Width }} &times; {{ $indexer.Height }} px</td>
                                </tr>
                                {{- end }}
                                {{- if $indexer.Duration }}
                                <tr>
                                    <td class="label">Dauer</td>
                                    <td class="val">{{ $indexer.Duration }} s</td>
                                </tr>
                                {{- end }}
                            {{- end }}
                            {{- if $filesystem }}
                                {{- range $ver, $fss := $filesystem }}
                                    {{- range $fs := $fss }}
                                        {{- range $extName := $extNames }}
                                            {{- if (eq $fs.Path $extName)}}
                                            <tr>
                                                <td class="label">Dateigröße</td>
                                                <td class="val">{{ humanizeBytes $fs.Meta.Size }} ({{ $fs.Meta.Size }} Bytes)</td>
                                            </tr>
                                            <tr>
                                                <td class="label">Zeitstempel</td>
                                                <td class="val">Erstellt: {{ humanizeTime $fs.Meta.CTime }} | Geändert: {{ humanizeTime $fs.Meta.MTime }}</td>
                                            </tr>
                                            {{- if $fs.Meta.Attr }}
                                            <tr>
                                                <td class="label">Attribute / OS</td>
                                                <td class="val">{{ $fs.Meta.Attr }} ({{ $fs.Meta.OS }})</td>
                                            </tr>
                                            {{- end }}
                                            {{- end }}
                                        {{- end }}
                                    {{- end }}
                                {{- end }}
                            {{- end }}
                            {{- if $isThumb }}
                            <tr>
                                <td class="label">Vorschaubild für</td>
                                <td class="val">{{ $thumb.SourceName }}</td>
                            </tr>
                            {{- end }}
                            <tr>
                                <td class="label">Prüfsumme</td>
                                <td class="val"><code style="font-size: 7.5pt;">{{ $cs }}</code></td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    {{- end }}
</div>
{{- end }}

</body>
</html>