{{ $root := . }}<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .title }} - {{ .id }}</title>
    <link rel="stylesheet" href="../../static/bootstrapdist/css/bootstrap.min.css">
    <link href="../../static/css/sidebar.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }
        .stat-card {
            border: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }
        .version-card {
            border-left: 4px solid #0d6efd !important;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .version-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08) !important;
        }
        .bd-aside {
            min-width: 260px;
        }
        .scrollarea-stats {
            max-height: 280px;
            overflow-y: auto;
        }
    </style>
</head>

<body class="py-3">
    <main class="d-flex overflow-visible">
        <h1 class="visually-hidden">{{ .title }}</h1>

        <!-- Sidebar -->
        <aside class="bd-aside sticky-top text-muted align-self-start mb-3 mb-xl-5 px-3">
            <div class="flex-shrink-0 p-3 bg-white rounded-3 shadow-sm" style="width: 260px;">
                <a href="../../" class="d-flex align-items-center pb-3 mb-3 link-dark text-decoration-none border-bottom">
                    <svg class="bi me-2 text-primary" width="28" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5v-3zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5h-3z"/>
                    </svg>
                    <span class="fs-5 fw-bold">gocfl</span>
                </a>
                <ul class="nav nav-pills flex-column mb-auto gap-1">
                    <li class="nav-item">
                        <a href="../../object/id/{{ .id | PathEscape }}" class="nav-link active d-flex align-items-center gap-2">
                            <svg class="bi" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5V6a.5.5 0 0 1-1 0V4.5A.5.5 0 0 1 8 4zM3.732 5.732a.5.5 0 0 1 .707 0l.915.914a.5.5 0 1 1-.708.708l-.914-.915a.5.5 0 0 1 0-.707zM2 10a.5.5 0 0 1 .5-.5h1.586a.5.5 0 0 1 0 1H2.5A.5.5 0 0 1 2 10zm9.5 0a.5.5 0 0 1 .5-.5h1.5a.5.5 0 0 1 0 1H12a.5.5 0 0 1-.5-.5zm.754-4.246a.389.389 0 0 0-.527-.02L7.547 9.31a.91.91 0 1 0 1.302 1.258l3.434-4.297a.389.389 0 0 0-.029-.518z"/><path fill-rule="evenodd" d="M0 10a8 8 0 1 1 15.547 2.661c-.442 1.253-1.845 1.602-2.932 1.25C11.309 13.488 9.475 13 8 13c-1.474 0-3.31.488-4.615.911-1.087.352-2.49.003-2.932-1.25A7.988 7.988 0 0 1 0 10zm8-7a7 7 0 0 0-6.603 9.329c.203.575.923.876 1.68.63C4.397 12.533 6.358 12 8 12s3.604.532 4.923.96c.757.245 1.477-.056 1.68-.631A7 7 0 0 0 8 3z"/></svg>
                            Object
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="../../object/id/{{ .id | PathEscape }}/manifest" class="nav-link text-dark d-flex align-items-center gap-2">
                            <svg class="bi text-secondary" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/></svg>
                            Manifest
                        </a>
                    </li>
                    {{ range $ver, $content := .versions }}
                    <li class="nav-item">
                        <a href="../../object/id/{{ $root.id | PathEscape }}/version/{{ $ver }}" class="nav-link text-dark d-flex align-items-center gap-2 ps-4">
                            <span class="badge bg-light text-dark border">{{ $ver }}</span>
                            <span>Version {{ $ver }}</span>
                        </a>
                    </li>
                    {{ end }}
                    <hr class="my-2">
                    <li class="nav-item">
                        <a target="_blank" href="../../object/id/{{ .id | PathEscape }}/report" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Short Report</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a target="_blank" href="../../object/id/{{ .id | PathEscape }}/report?full" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Full Report</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a target="_blank" href="../../object/id/{{ .id | PathEscape }}/browse/" class="nav-link text-dark d-flex align-items-center justify-content-between">
                            <span>Browse Files</span>
                            <span class="text-muted small">↗</span>
                        </a>
                    </li>
                    <hr class="my-2">
                    <li class="nav-item">
                        <a href="../../" class="nav-link text-secondary d-flex align-items-center gap-2">
                            <svg class="bi" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146zM2.5 14V7.707l5.5-5.5 5.5 5.5V14H10v-4a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5v4H2.5z"/></svg>
                            Storage Root
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="container-fluid bg-transparent px-4">
            <!-- Header Banner -->
            <div class="card shadow-sm border-0 mb-4 bg-white">
                <div class="card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <span class="text-uppercase text-muted fw-semibold small tracking-wide">OCFL Object</span>
                        <h1 class="h3 mb-0 mt-1 font-monospace fw-bold text-dark text-break">{{ .id }}</h1>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="../../object/id/{{ .id | PathEscape }}/manifest" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                            <svg class="bi" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm15 2h-4v3h4V4zm0 4h-4v3h4V8zm0 4h-4v3h3a1 1 0 0 0 1-1v-2zm-5 3v-3H6v3h4zm-5 0v-3H1v2a1 1 0 0 0 1 1h3zm-4-4h4V8H1v3zm0-4h4V4H1v3zm5-3v3h4V4H6zm4 4H6v3h4V8z"/></svg>
                            View Manifest
                        </a>
                        <a target="_blank" href="../../object/id/{{ .id | PathEscape }}/report?full" class="btn btn-primary btn-sm d-flex align-items-center gap-1">
                            Full Report
                        </a>
                    </div>
                </div>
            </div>

            <!-- Versions Section -->
            <div class="mb-5">
                <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                    <h2 class="h4 mb-0 fw-semibold">Versions</h2>
                    <span class="badge bg-secondary rounded-pill">{{ len .versions }} Version(s)</span>
                </div>
                <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-3">
                    {{ range $ver, $content := .versions }}
                    <div class="col">
                        <div class="card h-100 shadow-sm version-card bg-white border-0">
                            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                                <span class="badge bg-primary fs-6">{{ $ver }}</span>
                                <a href="../../object/id/{{ $root.id | PathEscape }}/version/{{ $ver }}" class="btn btn-sm btn-outline-primary">View Version</a>
                            </div>
                            <div class="card-body pt-0">
                                <h5 class="card-title fs-6 fw-bold text-dark mb-1">{{ $content.Name }}</h5>
                                {{ if $content.Address }}<p class="text-muted small mb-2">{{ $content.Address }}</p>{{ end }}
                                <p class="text-muted small mb-3">
                                    <svg class="bi me-1" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857V3.857z"/></svg>
                                    {{ $content.Created }}
                                </p>
                                {{ if $content.Message }}
                                <div class="p-2 bg-light rounded text-secondary small border">
                                    <em>{{ $content.Message }}</em>
                                </div>
                                {{ end }}
                            </div>
                        </div>
                    </div>
                    {{ end }}
                </div>
            </div>

            <!-- Statistics Section -->
            <div class="mb-5">
                <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                    <h2 class="h4 mb-0 fw-semibold">Statistics</h2>
                </div>

                {{ if gt (len .areaStats) 1 }}
                <div class="mb-4">
                    <h3 class="h5 fw-bold text-secondary mb-3">Total</h3>
                    <div class="row g-3 row-cols-1 row-cols-lg-3">
                        <!-- Quantities -->
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Quantities</h4>
                                </div>
                                <div class="card-body pt-0">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Number of Files:</span>
                                            <span class="fw-semibold">{{ .numFiles }}</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Number of different Files:</span>
                                            <span class="fw-semibold">{{ .differentFiles }}</span>
                                        </li>
                                        {{ if .size }}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Size of Data:</span>
                                            <span class="fw-semibold text-primary">{{ .size }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if .noSizeFiles }}
                                        <li class="list-group-item d-flex justify-content-between px-0 text-muted">
                                            <span>Files without size data:</span>
                                            <span class="badge bg-secondary rounded-pill">{{ .noSizeFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Pronoms -->
                        {{ if or .pronoms .noPronomFiles }}
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Pronoms</h4>
                                </div>
                                <div class="card-body pt-0 scrollarea-stats">
                                    <ul class="list-group list-group-flush small">
                                        {{ range $pronom, $count := .pronoms }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $pronom }}" target="_blank" class="text-decoration-none font-monospace">{{ $pronom }}</a>
                                            <span class="badge bg-primary rounded-pill">{{ $count }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if .noPronomFiles }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                            <em>Without PRONOM</em>
                                            <span class="badge bg-secondary rounded-pill">{{ .noPronomFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {{ end }}

                        <!-- Mimetypes -->
                        {{ if or .mimeTypes .noMimeTypeFiles }}
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Mimetypes</h4>
                                </div>
                                <div class="card-body pt-0 scrollarea-stats">
                                    <ul class="list-group list-group-flush small">
                                        {{ range $mime, $count := .mimeTypes }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span class="font-monospace text-truncate" style="max-width: 80%;">{{ $mime }}</span>
                                            <span class="badge bg-info text-dark rounded-pill">{{ $count }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if .noMimeTypeFiles }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                            <em>Without MIME-Type</em>
                                            <span class="badge bg-secondary rounded-pill">{{ .noMimeTypeFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {{ end }}
                    </div>
                </div>
                {{ end }}

                <!-- Area Stats -->
                {{ range $area := .areaStats }}
                <div class="mb-4">
                    {{ if or (gt (len $root.areaStats) 1) $area.Name }}
                    <h3 class="h4 fw-bold text-dark mt-3 mb-2">
                        Area: {{ if $area.Name }}{{ $area.Name }}{{ else }}Default Area{{ end }}
                        {{ if $area.Description }}<small class="text-muted fs-6 fw-normal">({{ $area.Description }}{{ if $area.Path }}, <code>{{ $area.Path }}</code>{{ end }})</small>{{ else if $area.Path }}<small class="text-muted fs-6 fw-normal">(<code>{{ $area.Path }}</code>)</small>{{ end }}
                    </h3>
                    {{ end }}
                    <div class="row g-3 row-cols-1 row-cols-lg-3">
                        <!-- Quantities -->
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Quantities</h4>
                                </div>
                                <div class="card-body pt-0">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Number of Files:</span>
                                            <span class="fw-semibold">{{ $area.NumFiles }}</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Number of different Files:</span>
                                            <span class="fw-semibold">{{ $area.DifferentFiles }}</span>
                                        </li>
                                        {{ if $area.SizeStr }}
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="text-muted">Size of Data:</span>
                                            <span class="fw-semibold text-primary">{{ $area.SizeStr }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if $area.NoSizeFiles }}
                                        <li class="list-group-item d-flex justify-content-between px-0 text-muted">
                                            <span>Files without size data:</span>
                                            <span class="badge bg-secondary rounded-pill">{{ $area.NoSizeFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Pronoms -->
                        {{ if or $area.Pronoms $area.NoPronomFiles }}
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Pronoms</h4>
                                </div>
                                <div class="card-body pt-0 scrollarea-stats">
                                    <ul class="list-group list-group-flush small">
                                        {{ range $pronom, $count := $area.Pronoms }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $pronom }}" target="_blank" class="text-decoration-none font-monospace">{{ $pronom }}</a>
                                            <span class="badge bg-primary rounded-pill">{{ $count }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if $area.NoPronomFiles }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                            <em>Without PRONOM</em>
                                            <span class="badge bg-secondary rounded-pill">{{ $area.NoPronomFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {{ end }}

                        <!-- Mimetypes -->
                        {{ if or $area.MimeTypes $area.NoMimeTypeFiles }}
                        <div class="col">
                            <div class="card h-100 shadow-sm stat-card bg-white">
                                <div class="card-header bg-white py-3 border-bottom-0">
                                    <h4 class="h6 fw-bold mb-0 text-dark">Mimetypes</h4>
                                </div>
                                <div class="card-body pt-0 scrollarea-stats">
                                    <ul class="list-group list-group-flush small">
                                        {{ range $mime, $count := $area.MimeTypes }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <span class="font-monospace text-truncate" style="max-width: 80%;">{{ $mime }}</span>
                                            <span class="badge bg-info text-dark rounded-pill">{{ $count }}</span>
                                        </li>
                                        {{ end }}
                                        {{ if $area.NoMimeTypeFiles }}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                            <em>Without MIME-Type</em>
                                            <span class="badge bg-secondary rounded-pill">{{ $area.NoMimeTypeFiles }}</span>
                                        </li>
                                        {{ end }}
                                    </ul>
                                </div>
                            </div>
                        </div>
                        {{ end }}
                    </div>
                </div>
                {{ else }}
                <div class="row g-3 row-cols-1 row-cols-lg-3">
                    <div class="col">
                        <div class="card h-100 shadow-sm stat-card bg-white">
                            <div class="card-header bg-white py-3 border-bottom-0">
                                <h4 class="h6 fw-bold mb-0 text-dark">Quantities</h4>
                            </div>
                            <div class="card-body pt-0">
                                <ul class="list-group list-group-flush small">
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted">Number of Files:</span>
                                        <span class="fw-semibold">{{ .numFiles }}</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted">Number of different Files:</span>
                                        <span class="fw-semibold">{{ .differentFiles }}</span>
                                    </li>
                                    {{ if .size }}
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted">Size of Data:</span>
                                        <span class="fw-semibold text-primary">{{ .size }}</span>
                                    </li>
                                    {{ end }}
                                    {{ if .noSizeFiles }}
                                    <li class="list-group-item d-flex justify-content-between px-0 text-muted">
                                        <span>Files without size data:</span>
                                        <span class="badge bg-secondary rounded-pill">{{ .noSizeFiles }}</span>
                                    </li>
                                    {{ end }}
                                </ul>
                            </div>
                        </div>
                    </div>

                    {{ if or .pronoms .noPronomFiles }}
                    <div class="col">
                        <div class="card h-100 shadow-sm stat-card bg-white">
                            <div class="card-header bg-white py-3 border-bottom-0">
                                <h4 class="h6 fw-bold mb-0 text-dark">Pronoms</h4>
                            </div>
                            <div class="card-body pt-0 scrollarea-stats">
                                <ul class="list-group list-group-flush small">
                                    {{ range $pronom, $count := .pronoms }}
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <a href="https://www.nationalarchives.gov.uk/PRONOM/{{ $pronom }}" target="_blank" class="text-decoration-none font-monospace">{{ $pronom }}</a>
                                        <span class="badge bg-primary rounded-pill">{{ $count }}</span>
                                    </li>
                                    {{ end }}
                                    {{ if .noPronomFiles }}
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                        <em>Without PRONOM</em>
                                        <span class="badge bg-secondary rounded-pill">{{ .noPronomFiles }}</span>
                                    </li>
                                    {{ end }}
                                </ul>
                            </div>
                        </div>
                    </div>
                    {{ end }}

                    {{ if or .mimeTypes .noMimeTypeFiles }}
                    <div class="col">
                        <div class="card h-100 shadow-sm stat-card bg-white">
                            <div class="card-header bg-white py-3 border-bottom-0">
                                <h4 class="h6 fw-bold mb-0 text-dark">Mimetypes</h4>
                            </div>
                            <div class="card-body pt-0 scrollarea-stats">
                                <ul class="list-group list-group-flush small">
                                    {{ range $mime, $count := .mimeTypes }}
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span class="font-monospace text-truncate" style="max-width: 80%;">{{ $mime }}</span>
                                        <span class="badge bg-info text-dark rounded-pill">{{ $count }}</span>
                                    </li>
                                    {{ end }}
                                    {{ if .noMimeTypeFiles }}
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-muted">
                                        <em>Without MIME-Type</em>
                                        <span class="badge bg-secondary rounded-pill">{{ .noMimeTypeFiles }}</span>
                                    </li>
                                    {{ end }}
                                </ul>
                            </div>
                        </div>
                    </div>
                    {{ end }}
                </div>
                {{ end }}
            </div>
        </div>
    </main>

    <script src="../../static/bootstrapdist/js/bootstrap.bundle.min.js"></script>
</body>
</html>